{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C-DNA",
  "version": "0.1.0",
  "identifier": "org.rev-c.cdna",
  "build": {
    "frontendDist": "resources/shell"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/cdna"
    ],
    "resources": {
      "resources/ui/": "ui/",
      "resources/learner/": "learner/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}

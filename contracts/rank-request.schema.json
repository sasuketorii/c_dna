{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDNA_RankOptionsRequest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "workspace_id", "mode", "domain", "context", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "mode": {"enum": ["imitate", "advisor"]},
    "domain": {
      "enum": ["resource_allocation", "product_delivery", "customer_commercial", "organization_delegation", "growth_strategy", "risk_reputation"]
    },
    "context": {"$ref": "#/$defs/context"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "include_evidence": {"type": "boolean", "default": true},
    "allow_cloud": {"type": "boolean", "default": false}
  },
  "$defs": {
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_minor", "currency"],
      "properties": {
        "amount_minor": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "factValue": {
      "anyOf": [
        {"type": "string", "maxLength": 2048},
        {"type": "number", "minimum": -1000000000000, "maximum": 1000000000000},
        {"type": "boolean"},
        {"type": "null"},
        {"$ref": "#/$defs/money"},
        {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 128}
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "evidence_status"],
      "properties": {
        "key": {"$ref": "#/$defs/fieldKey"},
        "value": {"$ref": "#/$defs/factValue"},
        "evidence_status": {"enum": ["explicit", "inferred", "unknown"]},
        "unit": {"type": "string", "maxLength": 32}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "summary", "facts", "unknown_fields"],
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 32768},
        "facts": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/fact"}
        },
        "unknown_fields": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldKey"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "attributes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "attributes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/fieldKey"},
          "additionalProperties": {"$ref": "#/$defs/factValue"}
        }
      }
    }
  }
}

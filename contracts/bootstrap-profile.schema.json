{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "context",
    "criteria",
    "contradictions",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "limitations"
      ],
      "properties": {
        "availability": {
          "enum": [
            "available",
            "partial",
            "unavailable",
            "unknown"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "priority",
          "tradeoffs",
          "examples",
          "exceptions",
          "reversal_conditions",
          "evidence",
          "confidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "tradeoffs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "examples": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "exceptions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "reversal_conditions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "reference",
                "statement_category"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "direct_quote",
                    "remembered_summary",
                    "inference"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "reference": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "statement_category": {
                  "enum": [
                    "actual_decision",
                    "reported_policy",
                    "ideal",
                    "ai_inference",
                    "unknown"
                  ]
                }
              }
            }
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "self_report",
              "basis"
            ],
            "properties": {
              "self_report": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "\\S"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEO-DNA bootstrap judgement profile 1.0",
  "description": "AI-generated hypotheses only. Transport limit 262144 UTF-8 bytes; duplicate keys rejected recursively. Confidence is uncalibrated provider self-report. References are unverified user-supplied text, never fetched.",
  "allOf": [
    {
      "if": {
        "properties": {
          "unknowns": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "minItems": 1,
            "items": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
